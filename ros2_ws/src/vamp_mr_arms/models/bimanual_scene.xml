      <geom name="conveyor_bin_wall_right" type="box" size="0.005 0.20 0.03" pos="-0.145 0 0.05"
            rgba="0.6 0.4 0.2 1"/>
    </body>

    <body name="conveyer" pos="0 0.58 0.60">
      <geom mesh="conveyer" material="white" type="mesh" />
